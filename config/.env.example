# Alpaca API Credentials
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# paper or live
TRADING_MODE=paper

# Risk & Order Guardrails
MAX_RISK_PER_TRADE_PCT=0.02
DAILY_DRAWDOWN_LIMIT_PCT=0.05
MAX_ACCOUNT_EQUITY_RISK_PCT=0.10
ENFORCE_PDT_RULE=true
PDT_ACCOUNT_THRESHOLD=25000.00
EOD_FLUSH_TIME_EST=15:45

# Timeframe & Watchlist
TIMEFRAME=15m
SYMBOLS=["AAPL", "NVDA", "MSFT", "AMD", "DRAM", "TSM"]

# Notification Webhooks (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Heartbeat & Monitoring
HEARTBEAT_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
